# Application
APP_NAME=AI Customer Support Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8917
SECRET_KEY=dev-secret-change-in-production-openssl-rand-hex-32
CORS_ORIGINS=["http://localhost:3000","http://localhost:3017","http://localhost:5173","http://127.0.0.1:3017"]

# Host-mapped Compose ports (see docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=25433
POSTGRES_USER=aics
POSTGRES_PASSWORD=aics_secret
POSTGRES_DB=aics_db

REDIS_HOST=localhost
REDIS_PORT=26379
REDIS_DB=0

RABBITMQ_HOST=localhost
RABBITMQ_PORT=25672
RABBITMQ_USER=aics
RABBITMQ_PASSWORD=aics_secret

NEO4J_URI=bolt://localhost:27687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aics_neo4j_secret

VECTOR_STORE=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=26333
QDRANT_COLLECTION=knowledge_base
PINECONE_API_KEY=
PINECONE_INDEX=aics-knowledge
PINECONE_ENVIRONMENT=us-east-1
CHROMA_PERSIST_DIR=./data/chroma

DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LLAMA_BASE_URL=http://localhost:11434/v1
LLAMA_MODEL=llama3.1

# Embeddings: openai | bge | e5 | sentence_transformers
DEFAULT_EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
BGE_MODEL_NAME=BAAI/bge-large-en-v1.5
E5_MODEL_NAME=intfloat/e5-large-v2
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DIMENSION=3072

CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
CONFIDENCE_THRESHOLD=0.65
CLARIFICATION_CONFIDENCE_THRESHOLD=0.9
HANDOFF_CONFIDENCE_THRESHOLD=0.45

LOG_LEVEL=INFO
LOG_FORMAT=console
ENABLE_METRICS=true
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
