# Application
APP_NAME=AI Customer Support Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8917
SECRET_KEY=dev-secret-change-in-production-openssl-rand-hex-32
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aics
POSTGRES_PASSWORD=aics_secret
POSTGRES_DB=aics_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=aics
RABBITMQ_PASSWORD=aics_secret

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aics_neo4j_secret

# Vector store
VECTOR_STORE=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_base

# LLM providers (set keys to enable real models; stub used otherwise)
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LLAMA_BASE_URL=http://localhost:11434/v1
LLAMA_MODEL=llama3.1

# Embeddings
DEFAULT_EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RAG
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
CONFIDENCE_THRESHOLD=0.65
HANDOFF_CONFIDENCE_THRESHOLD=0.45

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=console
ENABLE_METRICS=true

# n8n
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
